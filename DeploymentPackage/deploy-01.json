      }
    },
    {
      "type": "Microsoft.Resources/deploymentScripts",
      "apiVersion": "2023-08-01",
      "name": "[concat('asclab-seed-',parameters('DeploymentID'))]",
      "location": "eastus",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities',variables('bootstrapIdentityName'))]": {}
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities',variables('bootstrapIdentityName'))]",
        "[resourceId('Microsoft.Authorization/roleAssignments',guid(resourceId('Microsoft.ContainerRegistry/registries',variables('acrName')),'bootstrap-acr-push'))]",
        "[resourceId('Microsoft.Authorization/roleAssignments',guid(resourceId('Microsoft.ContainerService/managedClusters','asclab-aks'),'bootstrap-contributor'))]",
        "[resourceId('Microsoft.Authorization/roleAssignments',guid(resourceId('Microsoft.Storage/storageAccounts',variables('storageName')),'bootstrap-blob-contributor'))]",
        "[resourceId('Microsoft.Authorization/roleAssignments',guid(resourceId('Microsoft.ContainerRegistry/registries',variables('acrName')),'aks-kubelet-acrpull'))]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers',variables('storageName'),'default','asclab-public-container')]",
        "[resourceId('Microsoft.ContainerService/managedClusters','asclab-aks')]",
        "[resourceId('Microsoft.Compute/virtualMachines','asclab-linux')]"
      ],
      "kind": "AzureCLI",
      "properties": {
        "azCliVersion": "2.57.0",
        "scriptContent": "set -euo pipefail\naz login --identity\naz aks install-cli\naz acr import --name $ACR_NAME --source mcr.microsoft.com/dotnet/core/aspnet:2.1 --image contoso-vulnerable/aspnet-core:2.1\naz storage container create --account-name $STORAGE_NAME --name asclab-public-container --public-access blob --auth-mode login\naz storage blob upload --account-name $STORAGE_NAME --container-name asclab-public-container --name customer-records.json --data '{\"customer\":\"Contoso Synthetic\",\"classification\":\"Sensitive\",\"record\":\"LAB-0001\"}' --auth-mode login --overwrite true\naz aks get-credentials --resource-group $RG_NAME --name asclab-aks --overwrite-existing\nkubectl create deployment vulnerable-aspnet --image=$ACR_NAME.azurecr.io/contoso-vulnerable/aspnet-core:2.1 --dry-run=client -o yaml | kubectl apply -f -\n",
        "environmentVariables": [
          {
            "name": "ACR_NAME",
            "value": "[variables('acrName')]"
          },
          {
            "name": "STORAGE_NAME",
            "value": "[variables('storageName')]"
          },
          {
            "name": "RG_NAME",
            "value": "[resourceGroup().name]"
          }
        ],
        "cleanupPreference": "Always",
        "retentionInterval": "P1D",
        "timeout": "PT30M"
      }
    },
    {
      "type": "Microsoft.Security/pricings",
      "apiVersion": "2024-01-01",
      "name": "CloudPosture",
      "properties": {
        "pricingTier": "Standard"
      }
    },
    {
      "type": "Microsoft.Security/pricings",
      "apiVersion": "2024-01-01",
      "name": "VirtualMachines",
      "properties": {
        "pricingTier": "Standard",
        "subPlan": "P2",
        "extensions": [
          {
            "name": "AgentlessVmScanning",
            "isEnabled": "True"
          }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "apiVersion": "2024-03-01",
      "name": "[concat(variables('LabVMName'),'/bootstrap')]",
      "location": "eastus",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines',variables('LabVMName'))]",
        "[resourceId('Microsoft.Resources/deploymentScripts',concat('asclab-seed-',parameters('DeploymentID')))]",
        "[resourceId('Microsoft.Compute/virtualMachines','asclab-win')]",
        "[resourceId('Microsoft.Compute/virtualMachines','asclab-win2')]",
        "[resourceId('Microsoft.Compute/virtualMachines','asclab-linux')]"
      ],
      "properties": {
        "publisher": "Microsoft.Compute",
        "type": "CustomScriptExtension",
        "typeHandlerVersion": "1.10",
        "autoUpgradeMinorVersion": true,
        "settings": {
          "fileUris": [
            "[variables('scripturl')]"
          ]
        },
        "protectedSettings": {
          "commandToExecute": "[concat('powershell.exe -ExecutionPolicy Bypass -File psscript-01.ps1 -AzureUserName ',parameters('azureUserName'),' -AzurePassword ',parameters('azurePassword'),' -AzureTenantID ',tenant().tenantId,' -AzureSubscriptionID ',subscription().subscriptionId,' -DeploymentID ',parameters('DeploymentID'),' -vmAdminUsername ',parameters('adminUsername'),' -vmAdminPassword ',parameters('adminPassword'),' -trainerUserName ',parameters('trainerUserName'),' -trainerUserPassword ',parameters('trainerUserPassword'))]"
        }
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[concat(variables('storageName'),'/default/asclab-public-container')]",
      "properties": {
        "publicAccess": "Blob"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts',variables('storageName'))]"
      ]
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2023-08-01",
      "name": "[concat(variables('sqlName'),'/asclab-db')]",
      "location": "eastus",
      "sku": {
        "name": "Basic",
        "tier": "Basic",
        "capacity": 5
      },
      "properties": {
        "collation": "SQL_Latin1_General_CP1_CI_AS",
        "maxSizeBytes": 104857600
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers',variables('sqlName'))]"
      ]
    },
    {
      "type": "Microsoft.Sql/servers/firewallRules",
      "apiVersion": "2023-08-01",
      "name": "[concat(variables('sqlName'),'/AllowAll')]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "255.255.255.255"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers',variables('sqlName'))]"
      ]
    }
  ],
  "outputs": {
    "LabVM DNS Name": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses',concat('labvm-pip-',parameters('DeploymentID'))),'2024-01-01').dnsSettings.fqdn]"
    },
    "LabVM Admin Username": {
      "type": "string",
      "value": "[parameters('adminUsername')]"
    },
    "LabVM Admin Password": {
      "type": "string",
      "value": "[parameters('adminPassword')]"
    },
    "Deployment ID": {
      "type": "string",
      "value": "[parameters('DeploymentID')]"
    },
    "SubscriptionID": {
      "type": "string",
      "value": "[subscription().subscriptionId]"
    },
    "TenantID": {
      "type": "string",
      "value": "[tenant().tenantId]"
    },
    "Trainer Username": {
      "type": "string",
      "value": "[parameters('trainerUserName')]"
    },
    "Trainer Password": {
      "type": "string",
      "value": "[parameters('trainerUserPassword')]"
    }
  }
}
